{
  "model": {
    "name": "efficientnet_cbam_stable",
    "pretrained": true,
    "cbam_variant": "default",
    "use_multiscale": false,
    "dropout": 0.5
  },
  "training": {
    "epochs": 50,
    "batch_size": 32,
    "learning_rate": 0.00001,
    "cbam_lr_multiplier": 1.0,
    "classifier_lr_multiplier": 1.0,
    "weight_decay": 0.0001,
    "early_stopping_patience": 10,
    "lr_factor": 0.5,
    "lr_patience": 5,
    "gradient_clip_max_norm": 0.1,
    "freeze_epochs": 999,
    "mixup_alpha": 0.0,
    "label_smoothing": 0.0
  },
  "data": {
    "data_dir": "../preprocessed_dataset",
    "image_size": 224,
    "num_workers": 4
  },
  "transfer_learning": {
    "baseline_path": "checkpoints/baselines/efficientnet_b0_enhanced_best.pth",
    "freeze_efficientnet": true,
    "freeze_epochs": 999
  }
}
