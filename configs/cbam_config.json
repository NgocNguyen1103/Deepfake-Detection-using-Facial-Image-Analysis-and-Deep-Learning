{
  "model": {
    "name": "efficientnet_cbam",
    "pretrained": true,
    "cbam_variant": "default",
    "dropout": 0.5,
    "cbam_config": {
      "in_channels": 1280,
      "reduction_ratio": 16,
      "kernel_size": 7
    }
  },
  "training": {
    "epochs": 50,
    "batch_size": 32,
    "learning_rate": 0.0001,
    "cbam_lr_multiplier": 2.0,
    "classifier_lr_multiplier": 1.5,
    "weight_decay": 0.0001,
    "early_stopping_patience": 10,
    "lr_factor": 0.5,
    "lr_patience": 3,
    "gradient_clip_max_norm": 1.0
  },
  "data": {
    "data_dir": "../preprocessed_dataset",
    "image_size": 224,
    "num_workers": 4
  },
  "transfer_learning": {
    "baseline_path": "checkpoints/baselines/efficientnet_b0_enhanced_best.pth",
    "freeze_efficientnet": false
  }
}
